server {
    listen 80;
    server_name stallcart.in www.stallcart.in 157.245.104.77;

    client_max_body_size 20M;

    location = /favicon.ico { access_log off; log_not_found off; }
    
    location /static/ {
        alias /var/www/stall_cart_project/staticfiles/;
    }

    location /media/ {
        alias /var/www/stall_cart_project/media/;
    }

    location / {
        include proxy_params;
        proxy_pass http://unix:/run/gunicorn.sock;
    }
}
